<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/my_card_margin_bottom"
    app:cardCornerRadius="@dimen/my_card_radius"
    app:cardElevation="@dimen/my_card_elevation"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/my_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/myRecipeImage"
                android:layout_width="@dimen/my_image_size"
                android:layout_height="@dimen/my_image_size"
                android:scaleType="centerCrop"
                android:background="#EEEEEE"
                tools:src="@tools:sample/backgrounds/scenic" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/field_spacing_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/myRecipeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Classic Pizza Margarita"
                    android:textColor="#111111"
                    android:textSize="@dimen/my_title_text_size"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <LinearLayout
                    android:id="@+id/myRecipeTagsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/my_tags_margin_top"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/myRecipeTag1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/row_reaction_text_margin_start"
                        android:background="@drawable/bg_tag_chip"
                        android:paddingStart="@dimen/my_tag_padding_horizontal"
                        android:paddingTop="@dimen/my_tag_padding_vertical"
                        android:paddingEnd="@dimen/my_tag_padding_horizontal"
                        android:paddingBottom="@dimen/my_tag_padding_vertical"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/my_tag_text_size"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/myRecipeTag2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_chip"
                        android:paddingStart="@dimen/my_tag_padding_horizontal"
                        android:paddingTop="@dimen/my_tag_padding_vertical"
                        android:paddingEnd="@dimen/my_tag_padding_horizontal"
                        android:paddingBottom="@dimen/my_tag_padding_vertical"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/my_tag_text_size"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/myRecipeMoreTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/my_tag_more_margin_start"
                        android:text=""
                        android:textColor="#666666"
                        android:textSize="@dimen/my_tag_text_size"
                        android:layout_gravity="center_vertical"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/my_stats_margin_top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/myRecipeLikes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="217 likes"
                        android:textColor="#666666"
                        android:textSize="@dimen/my_tag_text_size" />

                    <TextView
                        android:id="@+id/myRecipeComments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/my_stats_spacing"
                        android:text="38 comments"
                        android:textColor="#666666"
                        android:textSize="@dimen/my_tag_text_size" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/my_action_row_margin_top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:spacing="@dimen/my_action_button_spacing">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/myRecipeViewBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/my_action_button_height"
                android:layout_marginEnd="@dimen/my_action_button_spacing"
                android:layout_weight="1"
                android:background="@drawable/bg_view_button"
                android:padding="0dp"
                android:text="view"
                android:textAllCaps="false"
                android:textColor="#6D6D6D"
                android:textSize="@dimen/my_action_button_text_size"
                android:maxLines="1"
                android:ellipsize="end"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_eye"
                app:iconTint="#6D6D6D"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/my_action_icon_padding" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/myRecipeEditBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/my_action_button_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/my_action_button_spacing"
                android:layout_marginEnd="@dimen/my_action_button_spacing"
                android:text="edit"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/my_action_button_text_size"
                android:background="@drawable/bg_login_button"
                android:padding="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_pencil_edit_button"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/my_action_icon_padding" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/myRecipeDeleteBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/my_action_button_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/my_action_button_spacing"
                android:text="delete"
                android:textAllCaps="false"
                android:textColor="#FF5B5B"
                android:textSize="@dimen/my_action_button_text_size"
                android:background="@drawable/bg_delete_button"
                android:padding="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_garbage_delete_button"
                app:iconTint="#FF5B5B"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/my_action_icon_padding" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
