<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/list_header_height"
        android:background="@drawable/bg_home_header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="@dimen/list_menu_icon_size"
        android:layout_height="@dimen/list_menu_icon_size"
        android:layout_marginStart="@dimen/list_menu_margin_start"
        android:layout_marginTop="@dimen/list_menu_margin_top"
        android:contentDescription="@null"
        android:src="@drawable/ic_menu_custom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/headerLogo"
        android:layout_width="@dimen/list_menu_icon_size"
        android:layout_height="@dimen/list_menu_icon_size"
        android:layout_marginStart="@dimen/list_logo_margin_start"
        android:contentDescription="@null"
        android:src="@drawable/ic_chef_hat"
        app:layout_constraintBottom_toBottomOf="@id/menuIcon"
        app:layout_constraintStart_toEndOf="@id/menuIcon"
        app:layout_constraintTop_toTopOf="@id/menuIcon"
        app:layout_constraintVertical_bias="0.0"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/list_header_title_margin_start"
        android:text="Recipe Share"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/list_header_title_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/headerLogo"
        app:layout_constraintTop_toTopOf="@id/headerLogo"
        app:layout_constraintBottom_toBottomOf="@id/headerLogo" />

    <ImageView
        android:id="@+id/searchIcon"
        android:layout_width="@dimen/list_search_icon_size"
        android:layout_height="@dimen/list_search_icon_size"
        android:layout_marginStart="@dimen/list_search_margin_start"
        android:layout_marginTop="@dimen/list_search_margin_top"
        android:src="@drawable/ic_search_custom"
        android:contentDescription="@null"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuIcon" />

    <EditText
        android:id="@+id/searchRecipesEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/list_search_input_height"
        android:layout_marginStart="@dimen/list_search_input_margin_start"
        android:layout_marginEnd="@dimen/list_search_input_margin_end"
        android:background="@drawable/bg_home_search"
        android:hint="search recipes"
        android:paddingStart="@dimen/list_search_padding_horizontal"
        android:paddingEnd="@dimen/list_search_padding_horizontal"
        android:textColor="#FFFFFF"
        android:textColorHint="#F9E9EE"
        android:textSize="@dimen/list_search_text_size"
        android:backgroundTint="@null"
        app:layout_constraintStart_toEndOf="@id/searchIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/searchIcon"
        app:layout_constraintBottom_toBottomOf="@id/searchIcon" />

    <View
        android:id="@+id/contentBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F2F2F2"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recipesListRv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/list_content_padding_horizontal"
        android:paddingTop="@dimen/list_content_padding_top"
        android:paddingEnd="@dimen/list_content_padding_horizontal"
        android:paddingBottom="@dimen/list_content_padding_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addRecipeFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/list_fab_margin"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="@string/add_recipe"
        app:backgroundTint="#F57C3B"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>