<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/bg_home_header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="@dimen/header_icon_size"
        android:layout_height="@dimen/header_icon_size"
        android:layout_marginStart="@dimen/header_icon_margin_start"
        android:layout_marginTop="@dimen/header_icon_margin_top"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@null"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pageTitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_title_margin_start"
        android:text="My Profile"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/header_title_text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/backBtn"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn"
        app:layout_constraintEnd_toStartOf="@id/profileEditBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profileEditBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/profile_action_button_height"
        android:minWidth="@dimen/profile_action_button_min_width"
        android:layout_marginEnd="@dimen/profile_action_margin_end"
        android:text="edit"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="@dimen/action_button_text_size"
        android:background="@drawable/bg_small_save_button"
        android:padding="0dp"
        app:backgroundTint="@null"
        app:cornerRadius="@dimen/profile_action_button_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/form_padding_horizontal"
            android:paddingTop="@dimen/profile_content_padding_top"
            android:paddingEnd="@dimen/form_padding_horizontal"
            android:paddingBottom="@dimen/form_padding_bottom">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImageView"
                android:layout_width="@dimen/profile_image_size"
                android:layout_height="@dimen/profile_image_size"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_account"
                android:contentDescription="@string/profile_image"
                android:padding="@dimen/profile_image_padding"
                app:shapeAppearanceOverlay="@style/ProfileImageCircleShape"
                app:strokeColor="#F3328F"
                app:strokeWidth="@dimen/profile_image_stroke_width" />

            <TextView
                android:id="@+id/profileDisplayNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_name_margin_top"
                android:text="Amanda Hill"
                android:textColor="#666666"
                android:textSize="@dimen/profile_name_text_size"
                android:textStyle="normal" />

            <LinearLayout
                android:id="@+id/emailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_card_margin_top_large"
                android:background="@drawable/bg_profile_info_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/profile_card_padding_horizontal"
                android:paddingTop="@dimen/profile_card_padding_vertical"
                android:paddingEnd="@dimen/profile_card_padding_horizontal"
                android:paddingBottom="@dimen/profile_card_padding_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#8C8C8C"
                    android:textSize="@dimen/label_text_size" />

                <TextView
                    android:id="@+id/profileEmailTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/profile_card_value_margin_top"
                    android:text="amenda111@gmail.com"
                    android:textColor="#111111"
                    android:textSize="@dimen/profile_card_value_text_size"
                    android:textStyle="normal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/userIdCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_card_margin_top"
                android:background="@drawable/bg_profile_info_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/profile_card_padding_horizontal"
                android:paddingTop="@dimen/profile_card_padding_vertical"
                android:paddingEnd="@dimen/profile_card_padding_horizontal"
                android:paddingBottom="@dimen/profile_card_padding_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User ID"
                    android:textColor="#8C8C8C"
                    android:textSize="@dimen/label_text_size" />

                <TextView
                    android:id="@+id/profileUserIdTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/profile_card_value_margin_top"
                    android:text="159187"
                    android:textColor="#111111"
                    android:textSize="@dimen/profile_card_value_text_size"
                    android:textStyle="normal" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profilePickImageBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_margin_top"
                android:minHeight="@dimen/field_min_height"
                android:text="Change photo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/action_button_text_size"
                android:visibility="gone"
                android:background="@drawable/bg_login_button"
                app:backgroundTint="@null"
                app:cornerRadius="16dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profileDisplayNameEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_edit_field_margin_top"
                android:background="@drawable/bg_recipe_input"
                android:minHeight="@dimen/field_min_height"
                android:hint="Display name"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/field_padding_horizontal"
                android:paddingVertical="@dimen/field_padding_vertical"
                android:textColor="#000000"
                android:textColorHint="#8D8D8D"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/profileProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/progress_margin_top"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileUpdateBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_update_margin_top"
                android:minHeight="@dimen/profile_update_button_height"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="@dimen/action_button_text_size"
                android:visibility="gone"
                android:background="@drawable/bg_login_button"
                app:backgroundTint="@null"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>