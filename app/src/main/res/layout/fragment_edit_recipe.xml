<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/bg_home_header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="@dimen/header_icon_size"
        android:layout_height="@dimen/header_icon_size"
        android:layout_marginStart="@dimen/header_icon_margin_start"
        android:layout_marginTop="@dimen/header_icon_margin_top"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_arrow_back"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pageTitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_title_margin_start"
        android:text="Edit your Recipe"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/header_title_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/backBtn"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn"
        app:layout_constraintEnd_toStartOf="@id/editRecipeSaveBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/editRecipeSaveBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/header_action_margin_end"
        android:minHeight="@dimen/action_button_height"
        android:text="save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/action_button_text_size"
        android:textStyle="bold"
        android:background="@drawable/bg_small_save_button"
        android:padding="0dp"
        app:backgroundTint="@null"
        app:cornerRadius="@dimen/action_button_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_padding_horizontal"
            android:paddingTop="@dimen/form_padding_top"
            android:paddingEnd="@dimen/form_padding_horizontal"
            android:paddingBottom="@dimen/form_padding_bottom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recipe Image URL"
                android:textColor="#444444"
                android:textSize="@dimen/label_text_size" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRecipeImageEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_margin_top"
                android:background="@drawable/bg_recipe_input"
                android:minHeight="@dimen/field_min_height"
                android:hint="https://great-pizza-ever.com"
                android:inputType="textUri"
                android:paddingHorizontal="@dimen/field_padding_horizontal"
                android:paddingVertical="@dimen/field_padding_vertical"
                android:textColor="#000000"
                android:textColorHint="#8D8D8D" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editRecipePickImageBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_margin_top"
                android:minHeight="@dimen/field_min_height"
                android:text="Pick Recipe Photo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/action_button_text_size"
                android:background="@drawable/bg_login_button"
                android:padding="0dp"
                app:backgroundTint="@null"
                app:cornerRadius="16dp" />

            <ImageView
                android:id="@+id/editRecipeImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_margin_top"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_recipe_input"
                android:minHeight="@dimen/image_min_height"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/recipe_image_preview" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_margin_top"
                android:text="Recipe Title"
                android:textColor="#444444"
                android:textSize="@dimen/label_text_size" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRecipeTitleEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_margin_top"
                android:background="@drawable/bg_recipe_input"
                android:hint="e.g., Classic Chocolate Chip Cookies"
                android:inputType="textCapSentences"
                android:minHeight="@dimen/field_min_height"
                android:paddingHorizontal="@dimen/field_padding_horizontal"
                android:paddingVertical="@dimen/field_padding_vertical"
                android:textColor="#000000"
                android:textColorHint="#8D8D8D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_margin_top"
                android:text="Ingredients"
                android:textColor="#444444"
                android:textSize="@dimen/label_text_size" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRecipeIngredientsEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_margin_top"
                android:background="@drawable/bg_recipe_input"
                android:gravity="top|start"
                android:hint="Enter each ingredient on a new line e.g.,&#10;2 cups flour&#10;1 cup sugar&#10;3 eggs&#10;1 cup cocoa"
                android:inputType="textMultiLine"
                android:minHeight="@dimen/field_multiline_min_height"
                android:minLines="4"
                android:padding="@dimen/field_padding_horizontal"
                android:textColor="#000000"
                android:textColorHint="#8D8D8D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_margin_top"
                android:text="Preparation Instructions"
                android:textColor="#444444"
                android:textSize="@dimen/label_text_size" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRecipeInstructionsEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_margin_top"
                android:background="@drawable/bg_recipe_input"
                android:gravity="top|start"
                android:hint="Describe the preparation steps..."
                android:inputType="textMultiLine"
                android:minHeight="@dimen/field_multiline_min_height"
                android:minLines="4"
                android:padding="@dimen/field_padding_horizontal"
                android:textColor="#000000"
                android:textColorHint="#8D8D8D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_margin_top"
                android:text="Tags"
                android:textColor="#444444"
                android:textSize="@dimen/label_text_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_margin_top"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRecipeTagsEt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/field_spacing_horizontal"
                    android:background="@drawable/bg_recipe_input"
                    android:hint="e.g., Dessert, Quick, Vegetarian, Pizza"
                    android:inputType="text"
                    android:minHeight="@dimen/field_min_height"
                    android:paddingHorizontal="@dimen/field_padding_horizontal"
                    android:paddingVertical="@dimen/field_padding_vertical"
                    android:textColor="#000000"
                    android:textColorHint="#8D8D8D" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addTagBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/tag_button_min_width"
                    android:minHeight="@dimen/field_min_height"
                    android:text="add"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/action_button_text_size"
                    android:background="@drawable/bg_login_button"
                    android:padding="0dp"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tagsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chip_group_margin_top"
                app:chipSpacingHorizontal="@dimen/chip_spacing_horizontal"
                app:chipSpacingVertical="@dimen/chip_spacing_vertical"
                app:singleLine="false" />

            <ProgressBar
                android:id="@+id/editRecipeProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/progress_margin_top"
                android:visibility="gone" />

            <Button
                android:id="@+id/editRecipeCancelBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/cancel_margin_top"
                android:text="@string/cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>