<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/drawer_header_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/drawer_header_padding_horizontal"
    android:paddingEnd="@dimen/drawer_header_padding_horizontal"
    android:background="@drawable/bg_home_header_gradient">

    <ImageView
        android:id="@+id/drawerProfileImage"
        android:layout_width="@dimen/drawer_profile_size"
        android:layout_height="@dimen/drawer_profile_size"
        android:layout_marginEnd="@dimen/drawer_profile_margin_end"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@drawable/bg_circle_placeholder"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/drawerUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/drawer_name_text_size"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/drawerUserSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty"
            android:textColor="#FCEAF1"
            android:textSize="@dimen/drawer_subtitle_text_size" />
    </LinearLayout>

    <ImageView
        android:id="@+id/drawerCloseBtn"
        android:layout_width="@dimen/drawer_close_size"
        android:layout_height="@dimen/drawer_close_size"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFF"
        android:contentDescription="@null" />
</LinearLayout>