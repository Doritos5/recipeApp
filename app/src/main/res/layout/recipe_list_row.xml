<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_margin_bottom"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/row_padding_horizontal"
            android:paddingTop="@dimen/row_padding_top"
            android:paddingEnd="@dimen/row_padding_horizontal"
            android:paddingBottom="@dimen/row_padding_bottom"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/recipeAuthorAvatar"
                android:layout_width="@dimen/row_avatar_size"
                android:layout_height="@dimen/row_avatar_size"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_login_logo_circle"
                tools:src="@tools:sample/avatars" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/field_spacing_horizontal">

                <TextView
                    android:id="@+id/recipeAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amanda Hill"
                    android:textColor="#111111"
                    android:textSize="@dimen/row_author_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recipeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/row_date_margin_top"
                    android:text="12/08/2025"
                    android:textColor="#666666"
                    android:textSize="@dimen/row_date_text_size" />
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/recipeRowImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/row_image_height"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            tools:src="@tools:sample/backgrounds/scenic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/row_padding_horizontal"
            android:paddingTop="@dimen/row_reaction_padding_top"
            android:paddingEnd="@dimen/row_padding_horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/recipeLikeIcon"
                android:layout_width="@dimen/row_reaction_icon_size"
                android:layout_height="@dimen/row_reaction_icon_size"
                android:src="@drawable/ic_heart_custom"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/recipeLikesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_reaction_text_margin_start"
                android:text="217"
                android:textColor="#222222"
                android:textSize="@dimen/row_author_text_size" />

            <ImageView
                android:id="@+id/recipeCommentIcon"
                android:layout_width="@dimen/row_reaction_icon_size"
                android:layout_height="@dimen/row_reaction_icon_size"
                android:layout_marginStart="@dimen/row_reaction_spacing"
                android:src="@drawable/ic_comment_custom"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/recipeCommentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_reaction_text_margin_start"
                android:text="38"
                android:textColor="#222222"
                android:textSize="@dimen/row_author_text_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/recipeRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/row_padding_horizontal"
            android:paddingTop="@dimen/row_title_padding_top"
            android:paddingEnd="@dimen/row_padding_horizontal"
            android:text="Classic Pizza Margarita"
            android:textColor="#111111"
            android:textSize="@dimen/row_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recipeRowInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/row_padding_horizontal"
            android:paddingTop="@dimen/row_body_padding_top"
            android:paddingEnd="@dimen/row_padding_horizontal"
            android:paddingBottom="@dimen/row_body_padding_bottom"
            android:text="view all 38 comments"
            android:textColor="#777777"
            android:textSize="@dimen/row_body_text_size" />

        <ImageButton
            android:id="@+id/recipeRowEditBtn"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:background="@android:color/transparent"
            android:contentDescription="@string/edit_recipe" />

        <ImageButton
            android:id="@+id/recipeRowDeleteBtn"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:background="@android:color/transparent"
            android:contentDescription="@string/delete_recipe" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>