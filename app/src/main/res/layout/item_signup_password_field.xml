<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/signup_card_radius"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/signup_card_padding">

        <TextView
            android:id="@+id/fieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#3A3A3A"
            android:textSize="@dimen/signup_label_text_size" />

        <TextView
            android:id="@+id/passwordHelperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/signup_helper_margin_top"
            android:text="The password must be at least 8 characters long and include letters, numbers, and special characters"
            android:textColor="#8A8A8A"
            android:textSize="@dimen/signup_helper_text_size"
            android:lineSpacingExtra="@dimen/signup_helper_line_spacing" />

        <EditText
            android:id="@+id/fieldInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/signup_field_height"
            android:layout_marginTop="@dimen/signup_field_margin_top"
            android:background="@drawable/bg_form_field_input"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:paddingStart="@dimen/signup_input_padding_horizontal"
            android:paddingEnd="@dimen/signup_input_padding_horizontal"
            android:textColor="#000000"
            android:textColorHint="#8D8D8D"
            android:textSize="@dimen/signup_label_text_size" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>