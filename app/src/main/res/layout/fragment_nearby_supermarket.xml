<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_home_header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_menu_custom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/pageTitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="20dp"
        android:text="@string/nearby_supermarkets_title"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/menuIcon"
        app:layout_constraintTop_toTopOf="@id/menuIcon"
        app:layout_constraintBottom_toBottomOf="@id/menuIcon"
        app:layout_constraintEnd_toEndOf="parent" />

    <org.osmdroid.views.MapView
        android:id="@+id/nearbyMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toTopOf="@id/bottomSheetCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/osmAttributionTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:background="#99FFFFFF"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="© OpenStreetMap contributors"
        android:textColor="#333333"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/nearbyMapView"
        app:layout_constraintBottom_toTopOf="@id/bottomSheetCard" />

    <ProgressBar
        android:id="@+id/nearbySupermarketProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/nearbyMapView"
        app:layout_constraintBottom_toBottomOf="@id/nearbyMapView"
        app:layout_constraintStart_toStartOf="@id/nearbyMapView"
        app:layout_constraintEnd_toEndOf="@id/nearbyMapView" />

    <TextView
        android:id="@+id/nearbySupermarketStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:textColor="#333333"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/nearbyMapView"
        app:layout_constraintStart_toStartOf="@id/nearbyMapView"
        app:layout_constraintEnd_toEndOf="@id/nearbyMapView" />

    <Button
        android:id="@+id/nearbySupermarketRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nearby_retry"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/nearbySupermarketStatus"
        app:layout_constraintStart_toStartOf="@id/nearbyMapView"
        app:layout_constraintEnd_toEndOf="@id/nearbyMapView" />

    <LinearLayout
        android:id="@+id/bottomSheetCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_nearby_list_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        app:layout_constraintHeight_percent="0.42"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/nearbySupermarketRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/nearbySupermarketList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>