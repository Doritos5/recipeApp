<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <View
        android:id="@+id/splash_circle"
        android:layout_width="@dimen/splash_circle_size"
        android:layout_height="@dimen/splash_circle_size"
        android:background="@drawable/bg_splash_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/splash_icon"
        android:layout_width="@dimen/splash_icon_size"
        android:layout_height="@dimen/splash_icon_size"
        android:contentDescription="@null"
        android:src="@drawable/ic_chef_hat"
        app:layout_constraintTop_toTopOf="@id/splash_circle"
        app:layout_constraintBottom_toBottomOf="@id/splash_circle"
        app:layout_constraintStart_toStartOf="@id/splash_circle"
        app:layout_constraintEnd_toEndOf="@id/splash_circle" />

</androidx.constraintlayout.widget.ConstraintLayout>
