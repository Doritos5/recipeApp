<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Login Screen (Start Destination) -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.recipeapp.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_list"
            app:destination="@id/recipesListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_login_to_signUp"
            app:destination="@id/signUpFragment" />
    </fragment>

    <!-- Sign Up Screen -->
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.recipeapp.ui.SignUpFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_sign_up">

        <action
            android:id="@+id/action_signUp_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_signUp_to_list"
            app:destination="@id/recipesListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Recipe List Screen (All Recipes — Tab 1) -->
    <fragment
        android:id="@+id/recipesListFragment"
        android:name="com.example.recipeapp.ui.RecipesListFragment"
        android:label="All Recipes"
        tools:layout="@layout/fragment_recipes_list">

        <action
            android:id="@+id/action_list_to_add"
            app:destination="@id/addRecipeFragment" />

        <action
            android:id="@+id/action_recipeListFragment_to_recipeDetailFragment"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <!-- My Recipes Screen (Tab 2) -->
    <fragment
        android:id="@+id/myRecipesFragment"
        android:name="com.example.recipeapp.ui.MyRecipesFragment"
        android:label="My Recipes"
        tools:layout="@layout/fragment_my_recipes">

        <action
            android:id="@+id/action_myRecipes_to_editRecipe"
            app:destination="@id/editRecipeFragment" />

        <action
            android:id="@+id/action_myRecipes_to_add"
            app:destination="@id/addRecipeFragment" />

        <action
            android:id="@+id/action_myRecipes_to_recipeDetailFragment"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <!-- Profile Screen (Tab 3) -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.recipeapp.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.recipeapp.ui.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <!-- Add Recipe Screen -->
    <fragment
        android:id="@+id/addRecipeFragment"
        android:name="com.example.recipeapp.ui.AddRecipeFragment"
        android:label="Add Recipe"
        tools:layout="@layout/fragment_add_recipe" />

    <!-- Edit Recipe Screen (receives recipeId via SafeArgs) -->
    <fragment
        android:id="@+id/editRecipeFragment"
        android:name="com.example.recipeapp.ui.EditRecipeFragment"
        android:label="Edit Recipe"
        tools:layout="@layout/fragment_edit_recipe">

        <argument
            android:name="recipeId"
            app:argType="string" />
    </fragment>

    <!--Recipe Detail Screen-->
    <fragment
        android:id="@+id/recipeDetailFragment"
        android:name="com.example.recipeapp.ui.RecipeDetailFragment"
        android:label="Recipe Detail"
        tools:layout="@layout/fragment_recipe_detail">
    </fragment>

    <fragment
        android:id="@+id/nearbySupermarketFragment"
        android:name="com.example.recipeapp.ui.NearbySupermarketFragment"
        android:label="Nearby Supermarkets"
        tools:layout="@layout/fragment_nearby_supermarket" />

    <fragment
        android:id="@+id/nearbySupermarketDetailFragment"
        android:name="com.example.recipeapp.ui.NearbySupermarketDetailFragment"
        android:label="Nearby Supermarket Detail"
        tools:layout="@layout/fragment_nearby_supermarket_detail" />

</navigation>